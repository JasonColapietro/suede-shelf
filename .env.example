# PayPal REST app credentials from https://developer.paypal.com/dashboard/applications (Sandbox tab)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# Claude, for catalog extraction and the on-page AI shopper
ANTHROPIC_API_KEY=

# Durable storage (Upstash Redis or Vercel KV). Without these, stores live in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: public origin used in PayPal return links and MCP URLs
PUBLIC_BASE_URL=
